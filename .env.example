# Copy to .env.local and fill in. Set the same values in the Vercel project.

# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Optional. Defaults to claude-haiku-4-5.
# LLM_MODEL=claude-haiku-4-5

# Supabase project settings -> API. Server-side only; never expose the secret key to the browser.
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# A Clio developer app with read-only permissions (https://developers.clio.com/apps). Needed only on
# the machine that connects Clio; the tokens it obtains are kept in Supabase.
CLIO_CLIENT_ID=
CLIO_CLIENT_SECRET=
