# Copy to .env.local and fill in. Set the same values in the Vercel project.

# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Optional. Defaults to claude-haiku-4-5.
# LLM_MODEL=claude-haiku-4-5

# Supabase project settings -> API. Server-side only; never expose the secret key to the browser.
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# A Clio developer app with read-only permissions (https://developers.clio.com/apps). Needed only on
# the machine that connects Clio; the tokens it obtains are kept in Supabase.
CLIO_CLIENT_ID=
CLIO_CLIENT_SECRET=

# Twilio, for calls placed through Case Desk (https://console.twilio.com). The API key and the TwiML
# App (Voice Request URL: https://<your site>/api/calls/voice) are created once per account.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
TWILIO_TWIML_APP_SID=
# The number calls appear to come from: a Twilio number or a verified caller ID, as +1XXXXXXXXXX.
TWILIO_CALLER_ID=
# Optional. When set (comma separated), calls are only placed to these numbers. Use it with a sample
# matter whose phone numbers are made up, so a demonstration never rings a stranger.
TWILIO_ALLOWED_NUMBERS=
# Optional. Set to 1 to have Twilio transcribe both sides of a call as it happens.
TWILIO_TRANSCRIBE=
