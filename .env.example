# Copy to .env.local and fill in. Set the same values in the Vercel project.

# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Optional. Defaults to claude-haiku-4-5.
# LLM_MODEL=claude-haiku-4-5

# Supabase project settings -> API. Server-side only; never expose the secret key to the browser.
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Optional. When set, the whole site (pages and API) asks for this password, with any username.
# Set it on Vercel to keep strangers from spending API credits; leave unset for local dev.
# SITE_PASSWORD=
